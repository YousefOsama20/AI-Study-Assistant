# AI-Study-Assistant backend configuration (example)
#
# Copy this file to src/.env for local development, then fill in credentials.
# The Windows desktop app does not use this file: it stores non-secret settings
# in %APPDATA%\AI-Study-Assistant\config.json and secrets in
# %APPDATA%\AI-Study-Assistant\.env.
#
# Never commit a populated .env file.

# ========================= Application =========================
APP_NAME="AI-Study-Assistant"
APP_VERSION="1.0.0"

FILE_UPLOAD_TYPES=["application/pdf","text/plain"]
FILE_MAX_SIZE=10
FILE_DEFAULT_CHUNK_SIZE=512000

# ========================= Database =========================
# Matches docker/docker-compose.yml. Change the port if 5400 is already in use.
POSTGRES_USERNAME="postgres"
POSTGRES_PASSWORD="change-me"
POSTGRES_HOST="127.0.0.1"
POSTGRES_PORT=5400
POSTGRES_MAIN_DATABASE="ai_study_assistant"

# ========================= AI providers =========================
# OPENAI is the default for both generation and embeddings so a new user only
# needs one API key. COHERE and GEMINI are also supported.
GENERATION_BACKEND="OPENAI"
EMBEDDING_BACKEND="OPENAI"

OPENAI_API_KEY=""
OPENAI_API_URL=""
COHERE_API_KEY=""
GEMINI_API_KEY=""

GENERATION_MODEL_ID_LITERAL=["gpt-4o-mini","gpt-4.1-mini","command-a-03-2025","gemini-2.0-flash"]
GENERATION_MODEL_ID="gpt-4o-mini"
EMBEDDING_MODEL_ID="text-embedding-3-small"
EMBEDDING_MODEL_SIZE=1536

INPUT_DAFAULT_MAX_CHARACTERS=1024
GENERATION_DAFAULT_MAX_TOKENS=1500
GENERATION_DAFAULT_TEMPERATURE=0.1

# ========================= Vector database =========================
VECTOR_DB_BACKEND_LITERAL=["QDRANT","PGVECTOR"]
VECTOR_DB_BACKEND="PGVECTOR"
VECTOR_DB_PATH="qdrant_db"
VECTOR_DB_DISTANCE_METHOD="cosine"
VECTOR_DB_PGVEC_INDEX_THRESHOLD=100

# ========================= Documents and previews =========================
PREVIEW_DPI=150
PREVIEW_IMAGE_FORMAT="PNG"
MAX_PREVIEW_PAGES=10

CHUNK_SIZE_DEFAULT=1000
CHUNK_OVERLAP_DEFAULT=200

# ========================= Retrieval and answers =========================
RAG_ANSWER_LIMIT=8
RAG_CONTEXT_MAX_CHARS=20000
RAG_CHUNK_MAX_CHARS=2000
RAG_MAX_OUTPUT_TOKENS=1500
RAG_HISTORY_MESSAGES=8
RAG_HISTORY_MESSAGE_MAX_CHARS=2000

SUMMARY_SINGLE_PASS_MAX_CHARS=80000
SUMMARY_BATCH_MAX_CHARS=40000
SUMMARY_REDUCE_MAX_CHARS=60000
SUMMARY_MAX_CHUNKS=1200
SUMMARY_MAX_OUTPUT_TOKENS=2000
SUMMARY_MAP_MAX_OUTPUT_TOKENS=700
SUMMARY_CACHE_TTL_SECONDS=0

PRIMARY_LANG="en"
DEFAULT_LANG="en"

# ========================= Server =========================
# Leave HOST/PORT unset to use the defaults (127.0.0.1:5000 when packaged).
# HOST="0.0.0.0"
# PORT=5000
# RELOAD=false

# Comma-separated browser-development origins. Electron IPC does not need CORS.
# CORS_ALLOW_ORIGINS="http://localhost:5173"
