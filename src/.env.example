APP_NAME="mini-RAG"
APP_VERSION="0.1"
OPENAI_API_KEY=""

FILE_UPLOAD_TYPES=["text/plain","application/pdf"]
FILE_MAX_SIZE=10

FILE_DEFAULT_CHUNK_SIZE = 512000 # 512KB

POSTGRES_USERNAME=""
POSTGRES_PASSWORD=""
POSTGRES_HOST=""
POSTGRES_PORT=
POSTGRES_MAIN_DATABASE=""

# ========================= LLM Config =========================
GENERATION_BACKEND = "OPENAI"
EMBEDDING_BACKEND = "COHERE"

OPENAI_API_KEY=""
OPENAI_API_URL=
COHERE_API_KEY=""
GEMINI_API_KEY=""

GENERATION_MODEL_ID_LITERAL = ["gpt-4o-mini", "gemini-3.8-flash","command-a-03-2025"]
GENERATION_MODEL_ID="command-a-03-2025"
EMBEDDING_MODEL_ID="embed-multilingual-light-v3.0"
EMBEDDING_MODEL_SIZE=384

INPUT_DAFAULT_MAX_CHARACTERS=1024
GENERATION_DAFAULT_MAX_TOKENS=200
GENERATION_DAFAULT_TEMPERATURE=0.1

# ========================= Vector DB Config =========================
VECTOR_DB_BACKEND_LITERAL = ["QDRANT", "PGVECTOR"]
VECTOR_DB_BACKEND = "PGVECTOR"
VECTOR_DB_PATH = "qdrant_db"
VECTOR_DB_DISTANCE_METHOD = "cosine"
VECTOR_DB_PGVEC_INDEX_THRESHOLD = 100

# ========================= Preview Config =========================
PREVIEW_DPI = 150
PREVIEW_IMAGE_FORMAT = "PNG"
MAX_PREVIEW_PAGES = 10

# ========================= Chunk Config =========================
CHUNK_SIZE_DEFAULT = 1000
CHUNK_OVERLAP_DEFAULT = 200

# ========================= Template Configs =========================
PRIMARY_LANG = "ar"
DEFAULT_LANG = "en"

# ========================= Server / Runtime =========================
# Dev defaults: host 0.0.0.0, port 5000, reload on.
# Packaged (Electron) mode defaults: host 127.0.0.1, reload off.
HOST=""
PORT=""
RELOAD=""

# Packaged backend flag: forces 127.0.0.1 + no reload + auto-migration.
# Set automatically when frozen by PyInstaller (sys.frozen).
MINIRAG_PACKAGED=""
MINIRAG_AUTO_MIGRATE=""

# Redirects all file storage (assets/files, assets/database) to this dir.
# Useful for packaged installs where Program Files is read-only.
MINIRAG_DATA_DIR=""

# Narrow CORS allowlist for local browser development only (comma separated).
# Leave empty in production (Electron uses IPC). Example:
# CORS_ALLOW_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"
CORS_ALLOW_ORIGINS=""