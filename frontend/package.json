{
  "name": "ai-study-assistant-frontend",
  "private": true,
  "version": "1.0.0",
  "description": "AI-Study-Assistant desktop frontend (React + Electron)",
  "license": "Apache-2.0",
  "type": "module",
  "main": "electron/dist/main.js",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p electron/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "build:renderer": "vite build",
    "build:electron": "tsc -p electron/tsconfig.json",
    "icons": "python scripts/generate-icons.py",
    "electron:dev": "npm run build:electron && concurrently -k \"vite\" \"cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "backend:dev": "powershell -ExecutionPolicy Bypass -File scripts/backend-dev.ps1",
    "backend:build": "powershell -ExecutionPolicy Bypass -File scripts/build-backend.ps1",
    "dist:win": "npm run build && npm run build:electron && electron-builder --win --publish never",
    "dist:linux": "npm run build && npm run build:electron && electron-builder --linux --publish never",
    "preview": "vite preview"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-dropdown-menu": "^2.1.4",
    "@radix-ui/react-switch": "^1.1.2",
    "@radix-ui/react-tabs": "^1.1.2",
    "@radix-ui/react-tooltip": "^1.1.6",
    "clsx": "^2.1.1",
    "lucide-react": "^0.469.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "tailwind-merge": "^2.6.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.7.2",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  },
  "allowScripts": {
    "electron@33.4.11": true
  }
}
